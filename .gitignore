# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Test coverage output (regenerated by `npm run test:coverage`)
coverage/
**/coverage/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# GitHub token (used by setup-git.sh for credential restoration — must stay
# on disk but NEVER in git)
.github-token

# IM gateway file attachments (user-uploaded via chat — not source code)
upload/

# Tool results (captured bash/command outputs — not source code)
tool-results/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Code Siren runtime
server/backups/
server/.biometric-templates/
# Phase E: voice-settings.json + orchestrator-settings.json live here
# (user preferences, not source code — regenerated on first use)
server/.runtime/
# Agent run traces — runtime-generated JSONL, regenerated on every server boot
server/.traces/
server/.workspaces/
server/.env.local
server/.env.*.local
server/traces-export-*.json
server/settings-export-*.json

# Stray nested extraction artifact (duplicate of repo root — do NOT track)
/code_siren/
gcode-out/
*.stl
*.gcode

# Lockfiles (optional — keep if you want reproducible installs)
# package-lock.json
# yarn.lock

# Z.ai SDK credentials
.z-ai-config
**/.z-ai-config
server/dist/

# Phase E Kokoro sidecar — Python venv + model cache must NEVER be committed
# (learned from the accidental 1.4GB venv commit earlier this session).
# Only source files (sidecar.py + requirements.txt) should be tracked under
# server/sidecars/kokoro/. Everything else is regenerated on first run.
server/sidecars/kokoro/venv/
server/sidecars/kokoro/.venv/
server/sidecars/kokoro/model-cache/
server/sidecars/kokoro/__pycache__/
server/sidecars/kokoro/**/*.pyc
server/sidecars/kokoro/*.wav
server/sidecars/kokoro/*.pth

# Phase 3+ — Whisper ASR sidecar. Same rules as Kokoro — never commit the
# venv (1.1 GB) or model cache (~74 MB for base model).
server/sidecars/whisper/venv/
server/sidecars/whisper/.venv/
server/sidecars/whisper/model-cache/
server/sidecars/whisper/__pycache__/
server/sidecars/whisper/**/*.pyc
server/sidecars/whisper/*.wav
server/sidecars/whisper/*.pth


# Tarballs + download artifacts — never commit these
download/
app/public/models/avatars/custom/
