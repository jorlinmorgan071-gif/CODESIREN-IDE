# ── Code Siren server .env ──────────────────────────────────────────────
# Copy to .env and fill in. All values must come from process.env — never hardcoded.
# Phase 6 — see README.md "Environment Variables" section for the full list.

# ── Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# JWT — generate a strong random string for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me-in-production-32-chars-min
JWT_EXPIRES_IN=7d

# ── PostgreSQL ──────────────────────────────────────────────────────────
# If unreachable, the server starts in degraded in-memory mode.
# (Step 0 proof works without Postgres; migrations are ready for when it's available.)
PG_HOST=localhost
PG_PORT=5432
PG_DB=code_siren
PG_USER=code_siren
PG_PASSWORD=code_siren

# ── Ollama (Local LLM) ──────────────────────────────────────────────────
# Your Ollama instance. From your log: OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Your Ollama binary path (Windows): C:\Users\Jorlin\AppData\Local\Programs\Ollama\ollama.exe
# On Windows, set this in your .env:
# OLLAMA_BIN=C:\Users\Jorlin\AppData\Local\Programs\Ollama\ollama.exe
# Default model to use (change to whichever model you prefer):
OLLAMA_DEFAULT_MODEL=llama3.2
# The server will auto-start `ollama serve` if it's not running.

# ── Cloud LLM (optional — used as fallback when Ollama is offline) ──────
# Set OPENROUTER_API_KEY to use cloud models when Ollama is down.
# The router prefers Ollama (local) → OpenRouter (cloud) → stub (no LLM).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Agent Relay Orchestrator (optional — directive Section 5) ────────────
# GEMINI_API_KEY: Google AI Studio key for Gemini 2.5 Flash orchestrator.
# Get one at https://aistudio.google.com/apikey
# If unset, the orchestrator falls back to NVIDIA Nemotron via OpenRouter
# (which uses OPENROUTER_API_KEY above).
GEMINI_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ── Rate Limiting (Phase 3) ─────────────────────────────────────────────
# Per-IP and per-user request limits. Defaults are good for production.
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=200
RATE_LIMIT_WS_PER_SEC=10
RATE_LIMIT_WINDOW_MS=60000

# ── Request Timeout (Phase 3) ───────────────────────────────────────────
# Hard timeout for any single request (ms).
REQUEST_TIMEOUT_MS=30000

# ── Slow Request Logging (Phase 5) ──────────────────────────────────────
# Requests slower than this (ms) are logged + tracked in /api/performance/slow-requests.
SLOW_REQUEST_THRESHOLD_MS=500

# ── Phase D: External API Keys (Tier 2 — add your own keys) ─────────────
# These are optional. Leave empty to skip the corresponding Skill.
# Each key is scoped to a single external service — do NOT reuse one key
# for multiple services.

# News APIs
NEWSAPI_KEY=
GNEWS_KEY=
MEDIASTACK_KEY=

# Developer platforms
GITHUB_TOKEN=
DEVTO_API_KEY=
HASHNODE_API_KEY=

# Media & entertainment
TMDB_API_KEY=
OMDB_API_KEY=
GIPHY_API_KEY=
RAWG_API_KEY=
PUBG_API_KEY=

# Maps & location
MAPTILER_API_KEY=
OPENROUTESERVICE_KEY=
OPENWEATHERMAP_KEY=

# Finance
# Alpha Vantage: stock market data (TIME_SERIES_DAILY, GLOBAL_QUOTE) — key as `apikey` query param.
# Free tier: 25 requests/day.
ALPHA_VANTAGE_KEY=

# ExchangeRate-API: open-access currency rates — NO key needed for the open tier.
# The skill uses https://open.er-api.com/v6/latest/<base> which requires no auth.
# Key slot retained for future paid-tier upgrade only.
EXCHANGERATE_API_KEY=

# CurrencyFreaks + Fixer: INTENTIONALLY NOT BUILT.
# Reasoning (per Section 0 ground-truth pass):
#   1. Redundancy — ExchangeRate-API's open tier already provides currency
#      conversion with no key required, so these add no marginal capability.
#   2. Fixer free-tier restrictions — 100 requests/month and EUR-only base
#      currency. (Section 0 confirmed HTTPS works fine on the free tier.)
#   3. CurrencyFreaks — provides the same FX rates as ExchangeRate-API but
#      requires a key. No marginal capability for the cost of a key slot.
# Slots retained for future opt-in if a paid-tier use case arises.
CURRENCYFREAKS_KEY=
FIXER_API_KEY=

# Science & data
# NASA: skill uses shared public DEMO_KEY by default — no env var needed.
# This slot is documentation-only; to use a personal key (1000 req/hour vs
# DEMO_KEY's 30 req/hour shared pool), edit the URL in nasa-apod.toml directly.
NASA_API_KEY=

# YouTube Data API v3: simple API key (NOT OAuth). For read-only search/videos/channels.
# Setup: GCP project → enable "YouTube Data API v3" → create API key credential.
# Free tier: 10,000 units/day (search.list = 100 units/call → ~100 searches/day).
YOUTUBE_API_KEY=

# Phase E: Voice TTS providers
# ElevenLabs: BYOK (Bring Your Own Key) cloud TTS. Get a key at
# https://elevenlabs.io → Profile → API Keys. Free tier: 10,000 credits/month
# (1 character = 1 credit for eleven_multilingual_v2). When this key is not
# set, ElevenLabs shows as "unavailable" in the Voice tab and cannot be
# selected as the active TTS provider. Key is read at runtime — never logged,
# never stored in voice-settings.json.
ELEVENLABS_API_KEY=
