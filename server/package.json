{
  "name": "code-siren-server",
  "private": true,
  "version": "0.6.0-phase6",
  "type": "module",
  "description": "Code Siren backend — single Express + WS server, single JWT auth, single Model Router.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tests/e2e-architect.ts",
    "grep-audit": "bash ../scripts/grep-audit.sh",
    "doctor": "tsx scripts/doctor.ts",
    "preflight": "tsx scripts/preflight.ts",
    "verify": "npm run typecheck && npm run grep-audit && npm run test && echo '✓ Server verify passed'",
    "benchmark": "tsx scripts/benchmark.ts",
    "reset": "tsx scripts/reset.ts",
    "safe-reset": "tsx scripts/safe-reset.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "export-traces": "tsx scripts/export-traces.ts",
    "export-settings": "tsx scripts/export-settings.ts",
    "seed-memories": "tsx scripts/seed-memories.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "isolated-vm": "^6.1.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "playwright": "^1.62.1",
    "proxy-addr": "^2.0.8",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.9"
  }
}
