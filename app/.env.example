# Code Siren Frontend Environment Configuration
#
# Copy this file to .env and fill in the values.
# All values are read at build time by Vite (import.meta.env).

# The filesystem path of the workspace/project the user is working in.
# This is sent to the backend so the agent can read real project files.
# Example: /home/username/projects/my-app
VITE_WORKSPACE_ROOT=

# Backend API URL (default: http://localhost:3001/api)
VITE_API_URL=http://localhost:3001/api

# WebSocket URL (default: ws://localhost:3001/ws)
VITE_WS_URL=ws://localhost:3001/ws
