# Prevent npm from upgrading major versions via audit fix
# This stops `npm audit fix --force` from silently breaking the build
# by upgrading packages like tailwindcss from v3 to v4.
save-exact=false
audit-level=high
fund=false

# Pin the registry to the official npm registry. A previous lockfile was
# generated inside a sandbox whose default registry pointed at
# registry.npmmirror.com, which leaked 132 mirror URLs into
# app/package-lock.json. This pin ensures `npm install` always resolves
# against registry.npmjs.org regardless of the ambient npm config.
# The CI lockfile-hygiene job enforces this — it fails if any lockfile
# references registry.npmmirror.com.
registry=https://registry.npmjs.org/
